{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "zsh \"$CLAUDE_PROJECT_DIR/.claude/hooks/gui-docs-check.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "zsh \"$CLAUDE_PROJECT_DIR/.claude/hooks/protocol-docs-check.sh\""
          }
        ]
      }
    ]
  }
}
